---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';

const substackUrl = 'https://selectallfromdata.substack.com/';
---

<Layout title="Blog - Nicole L. Mark">
  <Navigation />
  
  <main class="pt-24">
    <section class="section-padding bg-gradient-to-br from-gray-900 to-gray-800">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-6">
            The blog now lives on Substack
          </h1>
          <p class="text-lg md:text-xl text-gray-300 mb-8">
            I'm sharing long-form writing, curated resources, and behind-the-scenes notes over on Substack. Join the community there for the latest updates.
          </p>
          <a
            href={substackUrl}
            class="btn-primary inline-flex items-center gap-2"
            target="_blank"
            rel="noopener noreferrer"
          >
            Visit Substack
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section-padding bg-gray-800">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center text-gray-300 space-y-6">
          <p>
            Looking for earlier posts? I'm keeping the archive offline for now while I migrate select pieces. Feel free to reach out if there's something specific you'd like access to in the meantime.
          </p>
          <a href="/contact" class="btn-secondary inline-block">
            Get in touch
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

