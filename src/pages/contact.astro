---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
---

<Layout title="Contact - Nicole L. Mark">
  <Navigation />
  
  <main class="pt-24">
    <!-- Contact Header -->
    <section class="section-padding bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800">
      <div class="container">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Get In Touch
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
            I like to work at the intersection of data, ideas, and impact. I'm energized by collaborators who care deeply about their work, who think creatively to solve problems, and express themselves authentically.
          </p>
        </div>
      </div>
    </section>

    <!-- Contact Methods -->
    <section class="section-padding">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12">
          <!-- Contact Form -->
          <div>
            <h2 class="text-2xl font-semibold mb-6">Send a Message</h2>
            <form 
              action="https://formspree.io/f/mpwjkdqk"
              method="POST" 
              class="space-y-6" 
              id="contact-form"
            >
              <div class="grid md:grid-cols-2 gap-6">
                <div>
                  <label for="firstName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    First Name *
                  </label>
                  <input 
                    type="text" 
                    id="firstName" 
                    name="first_name" 
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"
                  >
                </div>
                <div>
                  <label for="lastName" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                    Last Name *
                  </label>
                  <input 
                    type="text" 
                    id="lastName" 
                    name="last_name" 
                    required
                    class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"
                  >
                </div>
              </div>

              <div>
                <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Email Address *
                </label>
                <input 
                  type="email" 
                  id="email" 
                  name="_replyto" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"
                >
              </div>

              <div>
                <label for="organization" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Organization/Company
                </label>
                <input 
                  type="text" 
                  id="organization" 
                  name="organization"
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"
                >
              </div>

              <div>
                <label for="subject" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Subject *
                </label>
                <select 
                  id="subject" 
                  name="_subject" 
                  required
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"
                >
                  <option value="">Select a subject</option>
                  <option value="collaboration">Research Collaboration</option>
                  <option value="speaking">Speaking Engagement</option>
                  <option value="consulting">Consulting Opportunity</option>
                  <option value="job">Job Opportunity</option>
                  <option value="media">Media/Interview Request</option>
                  <option value="student">Student/Academic Question</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">
                  Message *
                </label>
                <textarea 
                  id="message" 
                  name="message" 
                  rows="6" 
                  required
                  placeholder="Please provide details about your inquiry, project timeline, and any specific requirements..."
                  class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent resize-vertical"
                ></textarea>
              </div>

              <!-- Honeypot for spam protection -->
              <input type="text" name="_gotcha" style="display:none" />
              
              <!-- Success/Error Messages -->
              <div id="form-messages" class="hidden">
                <div id="success-message" class="hidden p-4 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg">
                  <div class="flex items-center">
                    <span class="text-green-500 text-xl mr-3">✅</span>
                    <div>
                      <h3 class="text-green-800 dark:text-green-200 font-medium">Message sent successfully!</h3>
                      <p class="text-green-700 dark:text-green-300 text-sm">Thank you for reaching out. I'll get back to you within 24-48 hours.</p>
                    </div>
                  </div>
                </div>
                <div id="error-message" class="hidden p-4 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg">
                  <div class="flex items-center">
                    <span class="text-red-500 text-xl mr-3">❌</span>
                    <div>
                      <h3 class="text-red-800 dark:text-red-200 font-medium">Something went wrong</h3>
                      <p class="text-red-700 dark:text-red-300 text-sm">Please try again or email me directly at nicoledesignsdata@pm.me</p>
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex items-start">
                <input 
                  type="checkbox" 
                  id="newsletter" 
                  name="newsletter"
                  value="yes"
                  class="mt-1 h-4 w-4 text-brand-primary focus:ring-brand-primary border-gray-300 rounded"
                >
                <label for="newsletter" class="ml-2 text-sm text-gray-600 dark:text-gray-300">
                  I'd like to receive updates about new blog posts and research publications
                </label>
              </div>

              <button 
                type="submit" 
                id="submit-button"
                class="w-full btn-primary py-3 text-lg transition-all duration-200"
              >
                <span id="button-text">Send Message</span>
                <span id="button-loading" class="hidden">Sending...</span>
              </button>
            </form>
          </div>

          <!-- Contact Information -->
          <div>
            <h2 class="text-2xl font-semibold mb-6">Other Ways to Connect</h2>
            
            <div class="space-y-6">
              <!-- Email -->
              <div class="card p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-blue-600 dark:text-blue-400 text-xl">📧</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Email</h3>
                    <p class="text-gray-600 dark:text-gray-300">For general inquiries</p>
                  </div>
                </div>
                <a href="mailto:nicoledesignsdata@pm.me" class="text-blue-600 dark:text-blue-400 hover:underline">
                  nicoledesignsdata@pm.me
                </a>
              </div>

              <!-- LinkedIn -->
              <div class="card p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-blue-600 dark:text-blue-400 text-xl">💼</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">LinkedIn</h3>
                    <p class="text-gray-600 dark:text-gray-300">Professional networking</p>
                  </div>
                </div>
                <a href="https://linkedin.com/in/nicole-mark" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">
                  linkedin.com/in/nicole-mark
                </a>
              </div>

              <!-- GitHub -->
              <div class="card p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-gray-600 dark:text-gray-400 text-xl">💻</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">GitHub</h3>
                    <p class="text-gray-600 dark:text-gray-300">Code repositories and projects</p>
                  </div>
                </div>
                <a href="https://github.com/nicolelily" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">
                  github.com/nicolelily
                </a>
              </div>

              <!-- Bluesky -->
              <div class="card p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-blue-600 dark:text-blue-400 text-xl">☁️</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Bluesky</h3>
                    <p class="text-gray-600 dark:text-gray-300">Thoughts on data science and tech</p>
                  </div>
                </div>
                <a href="https://bsky.app/profile/nicoledesignsdata.com" target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">
                  @nicoledesignsdata.com
                </a>
              </div>

              <!-- Mastodon -->
              <div class="card p-6">
                <div class="flex items-center mb-4">
                  <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center mr-4">
                    <span class="text-purple-600 dark:text-purple-400 text-xl">🐘</span>
                  </div>
                  <div>
                    <h3 class="font-semibold text-gray-900 dark:text-white">Mastodon</h3>
                    <p class="text-gray-600 dark:text-gray-300">Open source social networking</p>
                  </div>
                </div>
                <a href="https://me.dm/@nicolemark" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">
                  @nicolemark@me.dm
                </a>
              </div>
            </div>

            <!-- Response Time -->
            <div class="mt-8 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg">
              <h3 class="font-semibold text-blue-900 dark:text-blue-100 mb-2">Response Time</h3>
              <p class="text-blue-800 dark:text-blue-200 text-sm">
                I typically respond to emails within 24-48 hours. For urgent matters, please mention "URGENT" in your subject line.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Speaking & Consulting -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <h2 class="section-title text-center">Speaking & Consulting</h2>
        
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="card p-6">
            <div class="text-center mb-4">
              <div class="w-16 h-16 bg-purple-100 dark:bg-purple-900 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-purple-600 dark:text-purple-400 text-2xl">🎤</span>
              </div>
              <h3 class="text-xl font-semibold mb-2">Speaking Engagements</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-4 text-center">
              Available for conferences, workshops, podcasts, and corporate events on topics including:
            </p>
            <ul class="text-sm text-gray-600 dark:text-gray-300 space-y-1">
              <li>• Machine Learning and AI Ethics</li>
              <li>• Data Visualization Best Practices</li>
              <li>• Healthcare Analytics Applications</li>
              <li>• Career Development in Data Science</li>
              <li>• Research Methodology and Statistics</li>
            </ul>
            <div class="mt-6 text-center">
              <a href="#contact-form" class="btn-secondary" onclick="document.getElementById('subject').value='speaking'; document.getElementById('subject').dispatchEvent(new Event('change'));">Request Speaker Kit</a>
            </div>
          </div>

          <div class="card p-6">
            <div class="text-center mb-4">
              <div class="w-16 h-16 bg-green-100 dark:bg-green-900 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-green-600 dark:text-green-400 text-2xl">💡</span>
              </div>
              <h3 class="text-xl font-semibold mb-2">Consulting Services</h3>
            </div>
            <p class="text-gray-600 dark:text-gray-300 mb-4 text-center">
              Offering consulting services for organizations looking to leverage data science and machine learning:
            </p>
            <ul class="text-sm text-gray-600 dark:text-gray-300 space-y-1">
              <li>• Data Strategy and Analytics Roadmaps</li>
              <li>• ML Model Development and Deployment</li>
              <li>• Data Visualization and Dashboard Design</li>
              <li>• Team Training and Skill Development</li>
              <li>• Research Collaboration and Methodology</li>
            </ul>
            <div class="mt-6 text-center">
              <a href="#contact-form" class="btn-primary">Discuss Your Project</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title text-center">Frequently Asked Questions</h2>
        
        <div class="max-w-3xl mx-auto space-y-6">
          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-3">What types of projects do you work on?</h3>
            <p class="text-gray-600 dark:text-gray-300">
              I work on a variety of data science projects including machine learning model development, data visualization dashboards, statistical analysis, and research collaborations. I'm particularly interested in healthcare analytics, ethical AI, and educational applications of data science.
            </p>
          </div>

          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-3">Are you available for full-time positions?</h3>
            <p class="text-gray-600 dark:text-gray-300">
              I'm currently pursuing my Master's degree and expect to graduate in Spring 2025. I'm open to discussing full-time opportunities that would begin after graduation, as well as part-time and consulting arrangements during my studies.
            </p>
          </div>

          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-3">Do you mentor students or early-career professionals?</h3>
            <p class="text-gray-600 dark:text-gray-300">
              Yes! I enjoy mentoring students and early-career professionals in data science. I currently supervise undergraduate research students and am happy to provide guidance on career development, academic pursuits, and technical skills development.
            </p>
          </div>

          <div class="card p-6">
            <h3 class="text-lg font-semibold mb-3">What's your typical response time?</h3>
            <p class="text-gray-600 dark:text-gray-300">
              I aim to respond to all inquiries within 24-48 hours. During busy periods (such as conference seasons or thesis deadlines), it may take up to a week. For urgent matters, please indicate this in your subject line.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Enhanced Contact form handling for Formspree
    document.addEventListener('DOMContentLoaded', function() {
      const contactForm = document.getElementById('contact-form');
      const submitButton = document.getElementById('submit-button');
      const buttonText = document.getElementById('button-text');
      const buttonLoading = document.getElementById('button-loading');
      const formMessages = document.getElementById('form-messages');
      const successMessage = document.getElementById('success-message');
      const errorMessage = document.getElementById('error-message');
      
      if (contactForm) {
        contactForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          // Show loading state
          submitButton.disabled = true;
          buttonText.classList.add('hidden');
          buttonLoading.classList.remove('hidden');
          
          // Hide any previous messages
          formMessages.classList.add('hidden');
          successMessage.classList.add('hidden');
          errorMessage.classList.add('hidden');
          
          try {
            // Get form data
            const formData = new FormData(this);
            
            // Submit to Formspree (or show placeholder message if endpoint not set)
            const formAction = this.getAttribute('action');
            
            if (formAction.includes('REPLACE_WITH_YOUR_FORM_ID')) {
              // Placeholder mode - show instruction message
              throw new Error('PLACEHOLDER_MODE');
            }
            
            const response = await fetch(formAction, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });
            
            if (response.ok) {
              // Success!
              formMessages.classList.remove('hidden');
              successMessage.classList.remove('hidden');
              this.reset();
            } else {
              throw new Error('Form submission failed');
            }
            
          } catch (error) {
            // Handle errors
            if (error.message === 'PLACEHOLDER_MODE') {
              // Special message for when form isn't set up yet
              alert('Form setup needed! Please replace REPLACE_WITH_YOUR_FORM_ID with your actual Formspree form ID. For now, please email me directly at nicoledesignsdata@pm.me');
            } else {
              // General error
              formMessages.classList.remove('hidden');
              errorMessage.classList.remove('hidden');
            }
          } finally {
            // Reset button state
            submitButton.disabled = false;
            buttonText.classList.remove('hidden');
            buttonLoading.classList.add('hidden');
          }
        });
      }

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    });
  </script>
</Layout>

