<Layout title="CV - Nicole Lillian Mark">
  <Navigation />
  
  <main class="pt-24">
    <!-- CV Header -->
    <section class="section-padding bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800">
      <div class="container">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Curriculum Vitae
          </h1>
          <div class="max-w-3xl mx-auto">
            <h2 class="text-2xl md:text-3xl text-gray-700 dark:text-gray-200 mb-4">
              Nicole Lillian Mark
            </h2>
            <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">
             Creative technologist specializing in data visualization, data storytelling, and data-driven decision making.
            </p>
            <div class="flex flex-wrap justify-center gap-6 text-gray-600 dark:text-gray-300">
              <div class="flex items-center gap-2">
                <span>📧</span>
                <a href="mailto:nicoledesignsdata@pm.me" class="hover:text-blue-600 dark:hover:text-blue-400">
                  nicoledesignsdata@pm.me
                </a>
              </div>
              <div class="flex items-center gap-2">
                <span>📱</span>
                <a href="tel:+18132307946" class="hover:text-blue-600 dark:hover:text-blue-400">
                  +1 813.230.7946
                </a>
              </div>
              <div class="flex items-center gap-2">
                <span>📍</span>
                <span>Rehoboth Beach, DE</span>
              </div>
            </div>
            <div class="flex flex-wrap justify-center gap-4 mt-6">
              <a href="https://github.com/nicolelily" target="_blank" class="btn-secondary text-sm">
                GitHub
              </a>
              <a href="https://linkedin.com/in/nicole-mark" target="_blank" class="btn-secondary text-sm">
                LinkedIn
              </a>
              <a href="https://orcid.org/0000-0001-8383-274X" target="_blank" class="btn-secondary text-sm">
                ORCID
              </a>
              <a href="https://www.researchgate.net/profile/Nicole-Mark" target="_blank" class="btn-secondary text-sm">
                ResearchGate
              </a>
              <a href="https://selectallfromdata.substack.com/" target="_blank" class="btn-primary text-sm">
                SELECT * FROM data; on Substack  
              </a>
              <a href="https://medium.com/@nicolemark" target="_blank" class="btn-secondary text-sm">
                Medium
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title">Education</h2>
        <div class="max-w-4xl mx-auto space-y-8">
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                  Master of Science in Data Science
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium">
                  University of Colorado Boulder
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300 mt-2 md:mt-0">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  2023 - Present
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Currently pursuing advanced studies in data science methodologies, machine learning, and statistical analysis.
            </p>
          </div>

          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-4">
              <div>
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                  Bachelor of Arts in English Communications and Technology
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium">
                  University of Maryland Baltimore County
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300 mt-2 md:mt-0">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  2001 - 2006
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Interdisciplinary program combining communications, technology, and analytical writing skills.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Professional Experience -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <h2 class="section-title">Professional Experience</h2>
        <div class="max-w-4xl mx-auto space-y-8">
          
          <!-- Nicole Designs Data LLC -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Principal Consultant
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Nicole Designs Data LLC
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-green-100 dark:bg-green-900 px-3 py-1 rounded-full text-sm">
                  01/2023 - Present
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Data visualization development with Tableau, JavaScript/TypeScript (Observable Plot, d3.js, chart.js, Recharts), Python (Plotly, Seaborn), and AWS QuickSight. Analytics strategy consulting, Tableau Desktop and Tableau Cloud training, data governance initiatives, and tech stack assessment.
            </p>
          </div>

          <!-- Cart.com -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Data Visualization Engineer
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Cart.com
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  05/2022 - 01/2023
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              On an Agile engineering team, created new data visualizations from ideation, wireframing, prototyping, and testing to deployment in production, primarily in Tableau. Collaborated on designs using Figma with the UX design team. Updated existing visualizations to meet new technical requirements, design standards, or customer needs. Supported Tableau Desktop and Tableau Server users across the organization. Advocated the adoption of a data dictionary, the clear definition of metrics, and data quality and governance initiatives.
            </p>
          </div>

          <!-- Olive AI -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Data Program Analyst
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Olive AI
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  05/2021 - 05/2022
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Coordinated data management activities including mapping product-specific data, HL7, and X12 standardized healthcare data. Co-led the data governance committee, made recommendations for management of new data and changes to our existing data contract. Worked with complex nested data structures stored in Postgres and MySQL databases within a multi-cloud data architecture including AWS S3, Redshift, Databricks, and Fivetran. Created and edited complex SQL queries. Developed data visualization style guide and Tableau dashboard templates for use throughout the organization. Data visualization, pharmacy, and 340B subject-matter expert.
            </p>
          </div>

          <!-- Idaho State University -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Data Curator
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium">
                  Idaho State University
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  08/2020 - 09/2021
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Collected, interpreted, and analyzed data for the ISU/CPESN Idaho COVID-19 Point-of-Care Testing Program. Developed a JavaScript web application for secure collection of PHI for delivery to the state's public health districts. Created program website. Advised pharmacy owners regarding technology solutions for documentation of their care plans. Calculated pharmacy payments and invoiced the university. Curated all data, contributed approximately 35% of the writing and all data visualizations to the project manuscript.
            </p>
          </div>

          <!-- Aspen RxHealth -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Data Analyst
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium">
                  Aspen RxHealth
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  02/2019 - 06/2021
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Created scheduled and ad-hoc reporting, data visualizations, and operational metrics dashboards with Tableau Desktop and AWS QuickSight. Answered data-related questions posed by clinical, operations, and sales teams. Gathered requirements from business stakeholders, documented decisions and actions in Jira. Served on the Data Governance Committee, Measures and Specifications Subcommittee, and Data Dictionary Subcommittee.
            </p>
          </div>

          <!-- Community Care of North Carolina -->
          <div class="card p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between mb-4">
              <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                  Data Analyst, Medicaid Pharmacy Programs & CMMI Innovations Grant
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium">
                  Community Care of North Carolina
                </p>
              </div>
              <div class="text-gray-600 dark:text-gray-300">
                <span class="bg-blue-100 dark:bg-blue-900 px-3 py-1 rounded-full text-sm">
                  05/2016 - 04/2019
                </span>
              </div>
            </div>
            <p class="text-gray-600 dark:text-gray-300">
              Analyzed and reported CMMI Innovations Grant Project data. Trained community pharmacy staff in North Carolina to use PHARMACeHOME software. Provided technical support, answered documentation and payment-related questions, and assured CMS and CMMI Innovations Grant requirements were met. Reviewed documentation submitted from pharmacies for quality. Facilitated CPESN QA, QI, and Best Practices Work Group. Served as Pharmacist eCare Plan (PeCP) subject matter expert. Contributed to the manuscript "Stages of Change: Moving Community Pharmacies From a Drug Dispensing to Population Health Management Model," published in Medical Care Research and Review, April 2019.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills & Technologies -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title">Skills & Technologies</h2>
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-2 gap-8">
            
            <!-- Data Visualization -->
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-blue-600 dark:text-blue-400">📊</span>
                Data Visualization
              </h3>
              <div class="flex flex-wrap gap-2">
                <span class="skill-tag">Tableau Desktop</span>
                <span class="skill-tag">Tableau Cloud</span>
                <span class="skill-tag">Tableau Server</span>
                <span class="skill-tag">Tableau Prep Builder</span>
                <span class="skill-tag">AWS QuickSight</span>
                <span class="skill-tag">D3.js</span>
                <span class="skill-tag">Plotly</span>
                <span class="skill-tag">MatplotLib</span>
                <span class="skill-tag">Seaborn</span>
              </div>
            </div>

            <!-- Programming Languages -->
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-green-600 dark:text-green-400">💻</span>
                Programming Languages
              </h3>
              <div class="flex flex-wrap gap-2">
                <span class="skill-tag">Python</span>
                <span class="skill-tag">JavaScript</span>
