            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-purple-600 dark:text-purple-400">🗄️</span>
                Data & Analytics
              </h3>
              <div class="flex flex-wrap gap-2">
                <span class="skill-tag">Pandas</span>
                <span class="skill-tag">Polars</span>
                <span class="skill-tag">PostgreSQL</span>
                <span class="skill-tag">Snowflake</span>
                <span class="skill-tag">AWS Redshift</span>
                <span class="skill-tag">AWS S3</span>
                <span class="skill-tag">AWS Glue</span>
                <span class="skill-tag">Athena</span>
                <span class="skill-tag">Alteryx</span>
                <span class="skill-tag">Dataiku</span>
              </div>
            </div>

            <!-- Design & Tools -->
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-orange-600 dark:text-orange-400">🎨</span>
                Design & Tools
              </h3>
              <div class="flex flex-wrap gap-2">
                <span class="skill-tag">Figma</span>
                <span class="skill-tag">Adobe Illustrator</span>
                <span class="skill-tag">Jira</span>
                <span class="skill-tag">Agile</span>
                <span class="skill-tag">Scrum</span>
                <span class="skill-tag">Qualtrics</span>
              </div>
            </div>
          </div>

          <!-- Healthcare Standards -->
          <div class="card p-6 mt-8">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
              <span class="text-red-600 dark:text-red-400">🏥</span>
              Healthcare Standards
            </h3>
            <div class="flex flex-wrap gap-2">
              <span class="skill-tag">HL7</span>
              <span class="skill-tag">FHIR</span>
              <span class="skill-tag">X12</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Publications -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <h2 class="section-title">Publications</h2>
        <div class="max-w-4xl mx-auto space-y-6">
          
          <div class="card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center flex-shrink-0">
                <span class="text-blue-600 dark:text-blue-400 text-xl">📄</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  Developing sustainable workflows for community pharmacy-based SARS-CoV-2 testing
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Journal of the American Pharmacists Association • August 14, 2021
                </p>
                <p class="text-gray-600 dark:text-gray-300 mb-3">
                  This study describes the successful rapid implementation of a COVID-19 testing program across 13 community pharmacies in Idaho from September-December 2020, which performed 2,425 tests and demonstrated that independent pharmacies can effectively expand public health testing capacity, particularly in rural and underserved areas.
                </p>
                <a href="http://nicolelily.github.io/files/DevelopingSustainableWorkflowsforCommunity-PharmacyBasedSARS-CoV-2Testing_pre-proof.pdf" 
                   target="_blank" 
                   class="text-blue-600 dark:text-blue-400 hover:underline text-sm">
                  View Publication →
                </a>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center flex-shrink-0">
                <span class="text-green-600 dark:text-green-400 text-xl">📄</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  Stages of Change: Moving Community Pharmacies From a Drug Dispensing to Population Health Management Model
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Medical Care Research and Review • April 3, 2019
                </p>
                <p class="text-gray-600 dark:text-gray-300 mb-3">
                  This study examined how 40 community pharmacies in North Carolina implemented a Medicaid population health management intervention, comparing implementation strategies between high- and low-performing pharmacies using Rogers's innovation implementation framework. The research found that while both groups used similar strategies, high-performing pharmacies executed them more effectively and were more likely to reach sustainment, particularly in areas like stakeholder engagement, staff training, and relationship-building with primary care providers.
                </p>
                <a href="https://journals.sagepub.com/doi/10.1177/1077558719841159" 
                   target="_blank" 
                   class="text-blue-600 dark:text-blue-400 hover:underline text-sm">
                  View Publication →
                </a>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center flex-shrink-0">
                <span class="text-purple-600 dark:text-purple-400 text-xl">📄</span>
              </div>
              <div class="flex-1">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
                  Evolution of the Pharmacy Practice Model to Improve Patient and Learner Outcomes: A Partnership in Patient Care Initiative (PIPC) in the HSCT Population
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-2">
                  Biology of Blood and Marrow Transplantation • February 1, 2012
                </p>
                <p class="text-gray-600 dark:text-gray-300 mb-3">
                  This initiative implemented a layered learning practice model (LLPM) in hematopoietic stem cell transplant care, where an Attending Pharmacist manages a team of pharmacists, residents, and students to achieve 100% completion rates for key pharmacy services while expanding educational opportunities for learners.
                </p>
                <a href="https://www.astctjournal.org/article/S1083-8791(11)00668-9/fulltext" 
                   target="_blank" 
                   class="text-blue-600 dark:text-blue-400 hover:underline text-sm">
                  View Publication →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Languages & Interests -->
    <section class="section-padding">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <div class="grid md:grid-cols-2 gap-8">
            
            <!-- Languages -->
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-blue-600 dark:text-blue-400">🌍</span>
                Languages
              </h3>
              <div class="space-y-3">
                <div class="flex justify-between items-center">
                  <span class="text-gray-700 dark:text-gray-300">English</span>
                  <span class="text-sm bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 px-2 py-1 rounded">
                    Native
                  </span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-gray-700 dark:text-gray-300">Spanish</span>
                  <span class="text-sm bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 px-2 py-1 rounded">
                    Conversational
                  </span>
                </div>
              </div>
            </div>

            <!-- Interests & Certifications -->
            <div class="card p-6">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
                <span class="text-purple-600 dark:text-purple-400">🧘</span>
                Interests & Certifications
              </h3>
              <div class="space-y-3">
                <div>
                  <p class="font-medium text-gray-700 dark:text-gray-300">Yoga</p>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Registered Yoga Teacher (E-RYT 200), Yoga Alliance Continuing Education Provider (YACEP)
                  </p>
                </div>
                <div>
                  <p class="font-medium text-gray-700 dark:text-gray-300">Personal Interests</p>
                  <p class="text-sm text-gray-600 dark:text-gray-400">
                    Literature, Travel, Dogs, Vegan lifestyle
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Download CV -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <div class="text-center">
          <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">
            Download CV
          </h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6 max-w-2xl mx-auto">
            Download a PDF version of my curriculum vitae for your records or to share with colleagues.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <button class="btn-primary" onclick="window.print()">
              🖨️ Print CV
            </button>
            <a href="/contact" class="btn-secondary">
              📧 Request PDF Version
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .skill-tag {
      @apply px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm;
    }

    /* Print styles */
    @media print {
      .section-padding {
        padding: 1rem 0;
      }
      
      .card {
        break-inside: avoid;
        margin-bottom: 1rem;
      }
      
      nav {
        display: none;
      }
      
      .btn-primary, .btn-secondary {
        display: none;
      }
    }
  </style>
</Layout>

