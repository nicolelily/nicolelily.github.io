---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/global.css";
---

<Layout title="Nicole L. Mark">
  <Navigation />

  <!-- Hero Section -->
  <section class="pt-24 pb-12 bg-gradient-to-br from-gray-900 to-gray-800">
    <div class="container">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1 text-center lg:text-left">
          <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
            Hi, I'm <span class="text-brand-accent">Nicole Mark</span>
          </h1>
          <p class="text-xl text-gray-300 mb-8 max-w-2xl">
            Data scientist, award-winning data visualization engineer, and
            creative technologist. I'm passionate about using data to tell
            compelling stories and drive decision-making.
          </p>
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start"
          >
            <a href="#portfolio" class="btn-primary">View My Work</a>
            <a href="#contact" class="btn-secondary">Get In Touch</a>
          </div>
        </div>
        <div class="flex-1 flex justify-center">
          <div class="w-80 h-80 flex items-center justify-center">
            <img
              src="/diverging-bars-logo-no-text.png"
              alt="Nicole Mark's Logo - Data Visualization Bars"
              class="w-72 h-72 object-contain transition-transform hover:scale-105 duration-300"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="section-padding">
    <div class="container">
      <h2 class="section-title text-center">About Me</h2>
      <div class="grid md:grid-cols-2 gap-8 items-start">
        <div class="card p-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl">🏠</span>
            <h3 class="text-xl font-semibold">Personal Background</h3>
          </div>
          <p class="text-lg text-gray-300 mb-6 leading-relaxed">
            I live and work in coastal Delaware with my family and the love of
            my life, my dog
            <a
              href="https://www.instagram.com/pittie_potato/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-accent hover:underline">Potato</a
            >. I'm currently pursuing my master's degree in data science at the
            University of Colorado Boulder while working on cutting-edge data
            storytelling and visualization engineering projects in the
            healthcare, veterinary, and biotechnology sectors.
          </p>
          <p class="text-lg text-gray-300 mb-6 leading-relaxed">
            My passion lies in creating beautiful data visualizations, building
            interactive applications, and conducting meaningful research that
            drives real-world impact.
          </p>
          <p class="text-lg text-gray-300 mb-8 leading-relaxed">
            When I'm not coding or analyzing data, I enjoy exploring the beaches
            of southern Delaware and Maryland's Eastern Shore, reading, writing,
            and spending time with my family and friends. I'm a long-time vegan,
            and I've always been passionate about animal welfare. To further the
            aim of advocating for breed-neutral legislation to protect all dogs,
            I created the <a
              href="https://www.bsldb.app/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-accent hover:underline"
              >U.S. Breed-Specific Legislation Database</a
            > and I volunteer with the <a
              href="https://www.shelteranimalscount.org/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-brand-accent hover:underline"
              >Shelter Animals Count National Database Project</a
            >.
          </p>
          <div class="border-t border-gray-700 pt-6">
            <div class="flex items-center gap-3 mb-4">
              <span class="text-xl">🛠️</span>
              <h4 class="text-lg font-medium">Skills & Technologies</h4>
            </div>
            <div class="flex flex-wrap gap-3">
              <span
                class="px-4 py-2 bg-brand-primary/20 text-brand-neutral rounded-full text-sm font-medium"
                >Python</span
              >
              <span
                class="px-4 py-2 bg-brand-secondary/20 text-brand-secondary rounded-full text-sm font-medium"
                >SQL</span
              >
              <span
                class="px-4 py-2 bg-brand-accent/20 text-lime-400 rounded-full text-sm font-medium"
                >JavaScript</span
              >
              <span
                class="px-4 py-2 bg-brand-neutral/30 text-brand-neutral rounded-full text-sm font-medium"
                >Data Visualization</span
              >
              <span
                class="px-4 py-2 bg-brand-secondary/20 text-brand-secondary rounded-full text-sm font-medium"
                >Tableau Desktop</span
              >
            </div>
          </div>
        </div>
        <div class="space-y-6">
          <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🎓</span>
              <h3 class="text-xl font-semibold">Current Academic Work</h3>
            </div>
            <p class="text-gray-300 mb-2 font-medium">
              Master of Science in Data Science degree in progress at the
              University of Colorado Boulder.
            </p>
            <p class="text-gray-300">
              I'm studying data ethics, the societal impacts of artificial
              intelligence, and information design for social good.
            </p>
          </div>
          <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">📊</span>
              <h3 class="text-xl font-semibold">Data Visualization</h3>
            </div>
            <p class="text-gray-300">
              As an independent data visualization and engineering consultant, I
              create compelling visual stories from complex datasets using
              modern tools and techniques. I'm particularly interested in using
              data visualization to tell stories that are informative, engaging,
              and inspire the reader to take action. I drive business value for
              my clients by helping them understand their data and make informed
              decisions. I don't shy away from tackling challenging projects and
              enjoy collaborating with cross-functional teams to deliver
              impactful solutions.
            </p>
          </div>
          <div class="card p-6">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-2xl">🚀</span>
              <h3 class="text-xl font-semibold">App Development</h3>
            </div>
            <p class="text-gray-300">
              I'm building interactive web applications and data tools that
              solve real-world problems. Currently, I am focused on the U.S.
              Breed-Specific Legislation (BSL) project, which aims to provide
              data-driven insights and resources for understanding the impact of
              breed-specific laws on dog populations and public safety.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Research Section -->
  <section id="research" class="section-padding bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Research & Publications</h2>
      <p class="section-subtitle text-center mx-auto">
        Academic contributions and research work in data science, pharmacy, and
        public health.
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="card p-6">
          <h3 class="text-xl font-semibold mb-3">Recent Publications</h3>
          <div class="space-y-4">
            <div class="border-l-4 border-brand-primary pl-4">
              <h4 class="font-medium mb-2">
                Developing sustainable workflows for community pharmacy-based
                SARS-CoV-2 testing
              </h4>
              <p class="text-sm text-gray-400 mb-1">
                Journal of the American Pharmacists Association, 2021
              </p>
              <p class="text-xs text-gray-500 leading-relaxed">
                Study of rapid COVID-19 testing implementation across 13 Idaho
                community pharmacies, demonstrating effective expansion of
                public health testing capacity in rural and underserved areas.
              </p>
            </div>
            <div class="border-l-4 border-brand-secondary pl-4">
              <h4 class="font-medium mb-2">
                Stages of Change: Moving Community Pharmacies From a Drug
                Dispensing to Population Health Management Model
              </h4>
              <p class="text-sm text-gray-400 mb-1">
                Medical Care Research and Review, 2019
              </p>
              <p class="text-xs text-gray-500 leading-relaxed">
                Examination of how 40 North Carolina community pharmacies
                implemented Medicaid population health management interventions,
                comparing high- and low-performing pharmacy strategies.
              </p>
            </div>
            <div class="border-l-4 border-brand-accent pl-4">
              <h4 class="font-medium mb-2">
                Evolution of the Pharmacy Practice Model to Improve Patient and
                Learner Outcomes: A Partnership in Patient Care Initiative
              </h4>
              <p class="text-sm text-gray-400 mb-1">
                Biology of Blood and Marrow Transplantation, 2012
              </p>
              <p class="text-xs text-gray-500 leading-relaxed">
                Development and evaluation of a layered learning practice model
                in hematopoietic stem cell transplant care, improving patient
                outcomes and pharmacy education through team-based care.
              </p>
            </div>
          </div>
          <a
            href="/publications"
            class="inline-block mt-4 text-brand-accent hover:underline"
            >View all publications →</a
          >
        </div>

        <div class="card p-6">
          <h3 class="text-xl font-semibold mb-3">Continuous Learning</h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium">Master's Program</h4>
              <p class="text-gray-300 text-sm">
                MS Data Science at University of Colorado Boulder, focusing on
                applied skills and industry applications.
              </p>
            </div>
            <div>
              <h4 class="font-medium">Professional Development</h4>
              <p class="text-gray-300 text-sm">
                Advanced Statistics, Deep Learning, Research Methods, and
                Applied Data Science coursework.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="section-padding">
    <div class="container">
      <h2 class="section-title text-center">Portfolio</h2>
      <p class="section-subtitle text-center mx-auto">
        A showcase of my data visualization projects, web applications, and
        interactive tools.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card overflow-hidden">
          <div
            class="h-48 bg-gradient-to-br from-amber-400 to-red-500 flex items-center justify-center"
          >
            <span class="text-white text-4xl">🏛️</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">
              U.S. Breed-Specific Legislation Database
            </h3>
            <p class="text-gray-300 mb-4">
              Comprehensive searchable database tracking breed-specific
              legislation across the United States, featuring interactive maps
              and detailed policy analysis for dog owners and advocates.
            </p>
            <div class="flex gap-2 mb-4">
              <span
                class="px-2 py-1 bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 rounded text-xs"
                >Database</span
              >
              <span
                class="px-2 py-1 bg-brand-secondary/20 text-brand-secondary rounded text-xs"
                >Policy Research</span
              >
              <span
                class="px-2 py-1 bg-brand-primary/20 text-brand-neutral rounded text-xs"
                >Public Service</span
              >
            </div>
            <div class="flex gap-3">
              <a
                href="https://bsldb.app"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline text-sm"
                >Visit Database →</a
              >
              <a
                href="https://github.com/nicolelily/us-bsl-db"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline text-sm">View Code →</a
              >
            </div>
          </div>
        </div>
        <div class="card overflow-hidden">
          <div
            class="h-48 bg-gradient-to-br from-brand-primary to-brand-neutral flex items-center justify-center"
          >
            <span class="text-white text-4xl">🐕</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Dog Breeds Explorer</h3>
            <p class="text-gray-300 mb-4">
              Interactive Streamlit application for exploring dog breed
              characteristics, using machine learning to analyze breed data and
              provide insights for potential pet owners.
            </p>
            <div class="flex gap-2 mb-4">
              <span
                class="px-2 py-1 bg-brand-primary/20 text-brand-neutral rounded text-xs"
                >Python</span
              >
              <span
                class="px-2 py-1 bg-brand-secondary/20 text-brand-secondary rounded text-xs"
                >Streamlit</span
              >
              <span
                class="px-2 py-1 bg-brand-accent/20 text-lime-400 rounded text-xs"
                >Data Analysis</span
              >
            </div>
            <div class="flex gap-3">
              <a
                href="https://nicolelily-dog-breeds-streamlit-app-tjc0dw.streamlit.app"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline text-sm">Live App →</a
              >
              <a
                href="https://github.com/nicolelily/dog-breeds-streamlit"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline text-sm">View Code →</a
              >
            </div>
          </div>
        </div>

        <div class="card overflow-hidden">
          <div
            class="h-48 bg-gradient-to-br from-brand-secondary to-brand-accent flex items-center justify-center"
          >
            <span class="text-white text-4xl">🔥</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">
              Canada Wildfires Analysis
            </h3>
            <p class="text-gray-300 mb-4">
              Interactive beeswarm plot visualization analyzing 2023 wildfire
              patterns in Canada using TypeScript and D3.js. Exercise from Nael
              Shiab's "Code Like a Journalist" course.
            </p>
            <div class="flex gap-2 mb-4">
              <span
                class="px-2 py-1 bg-brand-accent/20 text-lime-400 rounded text-xs"
                >TypeScript</span
              >
              <span
                class="px-2 py-1 bg-brand-neutral/30 text-brand-neutral rounded text-xs"
                >D3.js</span
              >
              <span
                class="px-2 py-1 bg-brand-secondary/20 text-brand-secondary rounded text-xs"
                >Data Journalism</span
              >
            </div>
            <div class="flex gap-3">
              <a
                href="https://github.com/nicolelily/canada-wildfires"
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand-accent hover:underline text-sm">View Code →</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/portfolio" class="btn-primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section id="blog" class="section-padding bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Latest Blog Posts</h2>
      <p class="section-subtitle text-center mx-auto">
        Thoughts, tutorials, and insights on data science, technology, and
        research.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <article class="card p-6">
          <div class="text-sm text-gray-400 mb-2">March 15, 2024</div>
          <h3 class="text-xl font-semibold mb-3">
            Getting Started with Advanced Data Visualization
          </h3>
          <p class="text-gray-300 mb-4">
            A comprehensive guide to creating compelling visualizations that
            tell meaningful stories with your data.
          </p>
          <a href="#" class="text-brand-accent hover:underline">Read more →</a>
        </article>

        <article class="card p-6">
          <div class="text-sm text-gray-400 mb-2">March 10, 2024</div>
          <h3 class="text-xl font-semibold mb-3">
            Machine Learning in Production
          </h3>
          <p class="text-gray-300 mb-4">
            Best practices for deploying and maintaining machine learning models
            in real-world applications.
          </p>
          <a href="#" class="text-brand-accent hover:underline">Read more →</a>
        </article>

        <article class="card p-6">
          <div class="text-sm text-gray-400 mb-2">March 5, 2024</div>
          <h3 class="text-xl font-semibold mb-3">The Future of Data Science</h3>
          <p class="text-gray-300 mb-4">
            Exploring emerging trends and technologies that are shaping the
            future of data science and analytics.
          </p>
          <a href="#" class="text-brand-accent hover:underline">Read more →</a>
        </article>
      </div>

      <div class="text-center mt-12">
        <a href="/blog" class="btn-primary">View All Posts</a>
      </div>
    </div>
  </section>

  <!-- Media Section -->
  <section id="media" class="section-padding">
    <div class="container">
      <h2 class="section-title text-center">Media & Speaking</h2>
      <p class="section-subtitle text-center mx-auto">
        Podcast appearances, conference talks, and panel discussions on data
        science and technology.
      </p>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-brand-accent">🎧</span>
            </div>
            <div>
              <a
                href="https://bit.ly/data-ideas-pod-s2-e47"
                target="_blank"
                rel="noopener noreferrer"
              >
                <h4 class="font-medium">Data Ideas Podcast</h4>
              </a>
              <p class="text-sm text-gray-400">
                February 22, 2024 - "How Data Capabilities & Skills Help Scale a
                Startup"
              </p>
              <p class="text-sm text-gray-400">Season 2, Episode 47</p>
            </div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-brand-secondary/10 dark:bg-brand-secondary/20 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-brand-secondary dark:text-brand-secondary"
                >🎧</span
              >
            </div>
            <div>
              <h4 class="font-medium">Tech Talk Tuesday</h4>
              <p class="text-sm text-gray-400">
                Building effective data visualization tools
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mt-8">
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-brand-accent/10 dark:bg-brand-accent/20 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-brand-accent dark:text-lime-400">🎯</span>
            </div>
            <div>
              <h4 class="font-medium">Data Science Conference 2024</h4>
              <p class="text-sm text-gray-400">
                Keynote: "The Future of Interactive Data Visualization"
              </p>
            </div>
          </div>
        </div>

        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div
              class="w-12 h-12 bg-brand-neutral/20 dark:bg-brand-neutral/30 rounded-lg flex items-center justify-center flex-shrink-0"
            >
              <span class="text-brand-primary dark:text-brand-neutral">🎯</span>
            </div>
            <div>
              <h4 class="font-medium">ML Summit 2024</h4>
              <p class="text-sm text-gray-400">
                Panel: "Ethics in Machine Learning Applications"
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href="/media" class="btn-primary">View All Media</a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section-padding bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Get In Touch</h2>
      <p class="section-subtitle text-center mx-auto">
        Interested in collaboration, speaking opportunities, or just want to
        chat about data science? I'd love to hear from you.
      </p>

      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-xl font-semibold mb-6">Let's Connect</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-lg flex items-center justify-center"
                >
                  <span class="text-brand-accent">📧</span>
                </div>
                <div>
                  <h4 class="font-medium">Email</h4>
                  <p class="text-gray-300">
                    <a
                      href="mailto:hello@nicoledesignsdata.net"
                      class="hover:text-brand-accent transition-colors"
                    >
                      hello@nicoledesignsdata.net
                    </a>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-brand-secondary/10 dark:bg-brand-secondary/20 rounded-lg flex items-center justify-center"
                >
                  <span class="text-brand-secondary dark:text-brand-secondary"
                    >💼</span
                  >
                </div>
                <div>
                  <h4 class="font-medium">LinkedIn</h4>
                  <p class="text-gray-300">
                    <a
                      href="https://linkedin.com/in/nicole-mark"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-brand-accent transition-colors"
                    >
                      linkedin.com/in/nicole-mark
                    </a>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-gray-700 rounded-lg flex items-center justify-center"
                >
                  <span class="text-gray-400">🐙</span>
                </div>
                <div>
                  <h4 class="font-medium">GitHub</h4>
                  <p class="text-gray-300">
                    <a
                      href="https://github.com/nicolelily"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-brand-accent transition-colors"
                    >
                      github.com/nicolelily
                    </a>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-blue-100 dark:bg-blue-900 rounded-lg flex items-center justify-center"
                >
                  <span class="text-blue-400">☁️</span>
                </div>
                <div>
                  <h4 class="font-medium">Bluesky</h4>
                  <p class="text-gray-300">
                    <a
                      href="https://bsky.app/profile/nicoledesignsdata.com"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-brand-accent transition-colors"
                    >
                      @nicoledesignsdata.com
                    </a>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-purple-100 dark:bg-purple-900 rounded-lg flex items-center justify-center"
                >
                  <span class="text-purple-400">🐘</span>
                </div>
                <div>
                  <h4 class="font-medium">Mastodon</h4>
                  <p class="text-gray-300">
                    <a
                      href="https://me.dm/@nicolemark"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-brand-accent transition-colors"
                    >
                      @nicolemark@me.dm
                    </a>
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div
                  class="w-12 h-12 bg-teal-100 dark:bg-teal-900 rounded-lg flex items-center justify-center"
                >
                  <span class="text-teal-600 dark:text-teal-400">📚</span>
                </div>
                <div>
                  <h4 class="font-medium">ResearchGate</h4>
                  <p class="text-gray-600 dark:text-gray-300">
                    <a
                      href="https://www.researchgate.net/profile/Nicole-Mark"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-brand-primary dark:hover:text-brand-accent transition-colors"
                    >
                      researchgate.net/profile/Nicole-Mark
                    </a>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <div class="card p-6">
            <h3 class="text-xl font-semibold mb-6">Send a Message</h3>
            <form
