  <script>
    // Homepage contact form handling
    document.addEventListener("DOMContentLoaded", function () {
      const homeForm = document.getElementById("homepage-contact-form");

      if (homeForm) {
        const submitButton = document.getElementById("home-submit-button");
        const buttonText = document.getElementById("home-button-text");
        const buttonLoading = document.getElementById("home-button-loading");
        const formMessages = document.getElementById("home-form-messages");
        const successMessage = document.getElementById("home-success-message");
        const errorMessage = document.getElementById("home-error-message");

        homeForm.addEventListener("submit", async function (e) {
          e.preventDefault();

          // Show loading state
          submitButton.disabled = true;
          buttonText.classList.add("hidden");
          buttonLoading.classList.remove("hidden");

          // Hide any previous messages
          formMessages.classList.add("hidden");
          successMessage.classList.add("hidden");
          errorMessage.classList.add("hidden");

          try {
            const formData = new FormData(this);
            const formAction = this.getAttribute("action");

            if (formAction.includes("REPLACE_WITH_YOUR_FORM_ID")) {
              throw new Error("PLACEHOLDER_MODE");
            }

            const response = await fetch(formAction, {
              method: "POST",
              body: formData,
              headers: {
                Accept: "application/json",
              },
            });

            if (response.ok) {
              formMessages.classList.remove("hidden");
              successMessage.classList.remove("hidden");
              this.reset();
            } else {
              throw new Error("Form submission failed");
            }
          } catch (error) {
            if (error.message === "PLACEHOLDER_MODE") {
              alert(
                "Form setup needed! Please use the full contact page or email me directly at nicoledesignsdata@pm.me"
              );
            } else {
              formMessages.classList.remove("hidden");
              errorMessage.classList.remove("hidden");
            }
          } finally {
            submitButton.disabled = false;
            buttonText.classList.remove("hidden");
            buttonLoading.classList.add("hidden");
          }
        });
      }
    });
  </script>
