---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
---

<Layout title="Nicole L. Mark">
  <Navigation />
  
  <!-- Hero Section -->
  <section class="pt-24 pb-12 bg-gradient-to-br from-slate-50 to-brand-neutral/20 dark:from-gray-900 dark:to-gray-800">
    <div class="container">
      <div class="flex flex-col lg:flex-row items-center gap-12">
        <div class="flex-1 text-center lg:text-left">
          <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white mb-6">
            Hi, I'm <span class="text-brand-primary dark:text-brand-accent">Nicole Mark</span>
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl">
            Data Scientist, information designer, and creative technologist passionate about turning complex data into meaningful insights and building tools that make a difference.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
            <a href="#portfolio" class="btn-primary">View My Work</a>
            <a href="#contact" class="btn-secondary">Get In Touch</a>
          </div>
        </div>
        <div class="flex-1 flex justify-center">
          <div class="w-80 h-80 flex items-center justify-center">
            <img 
              src="/diverging-bars-logo-no-text.png" 
              alt="Nicole Mark's Logo - Data Visualization Bars" 
              class="w-72 h-72 object-contain transition-transform hover:scale-105 duration-300"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

<!-- About Section -->
<section id="about" class="section-padding">
  <div class="container">
    <h2 class="section-title text-center">About Me</h2>
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="card p-8">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🏠</span>
          <h3 class="text-xl font-semibold">Personal Background</h3>
        </div>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
          I live and work in coastal Delaware with my family and the love of my life, my dog 
          <a href="https://www.instagram.com/pittie_potato/" target="_blank" rel="noopener noreferrer" class="text-brand-primary dark:text-brand-accent hover:underline">Potato</a>.
          I'm currently pursuing my Master's degree in data science at the University of Colorado Boulder while working on cutting-edge data science projects in the 
          healthcare and biotechnology sectors.
        </p>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-6 leading-relaxed">
          My passion lies in creating beautiful data visualizations, building interactive applications, and 
          conducting meaningful research that drives real-world impact.
        </p>
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
          When I'm not coding or analyzing data, I enjoy exploring southern Delaware and Maryland's Eastern Shore, 
          reading, writing, and spending time with my family and friends.
        </p>
        
        <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xl">🛠️</span>
            <h4 class="text-lg font-medium">Skills & Technologies</h4>
          </div>
          <div class="flex flex-wrap gap-3">
            <span class="px-4 py-2 bg-brand-primary/10 dark:bg-brand-primary/20 text-brand-primary dark:text-brand-neutral rounded-full text-sm font-medium">Python</span>
            <span class="px-4 py-2 bg-brand-secondary/10 dark:bg-brand-secondary/20 text-brand-secondary dark:text-brand-secondary rounded-full text-sm font-medium">R</span>
            <span class="px-4 py-2 bg-brand-accent/10 dark:bg-brand-accent/20 text-brand-accent dark:text-lime-400 rounded-full text-sm font-medium">Machine Learning</span>
            <span class="px-4 py-2 bg-brand-neutral/20 dark:bg-brand-neutral/30 text-brand-primary dark:text-brand-neutral rounded-full text-sm font-medium">Data Visualization</span>
            <span class="px-4 py-2 bg-brand-secondary/10 dark:bg-brand-secondary/20 text-brand-secondary dark:text-brand-secondary rounded-full text-sm font-medium">Web Development</span>
          </div>
        </div>
      </div>
      <div class="space-y-6">
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🎓</span>
            <h3 class="text-xl font-semibold">Current Academic Work</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300 mb-2 font-medium">Master's degree in progress at the University of Colorado Boulder.</p>
          <p class="text-gray-600 dark:text-gray-300">I'm focused on data ethics, societal impacts of artificial intelligence, and information design for public health, healthcare, and social justice.</p>
        </div>
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">📊</span>
            <h3 class="text-xl font-semibold">Data Visualization</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300">Creating compelling visual stories from complex datasets using modern tools and techniques. I'm particularly interested in using data visualization to tell stories that are informative, engaging, and inspire the reader to take action.</p>
        </div>
        <div class="card p-6">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl">🚀</span>
            <h3 class="text-xl font-semibold">App Development</h3>
          </div>
          <p class="text-gray-600 dark:text-gray-300">Building interactive web applications and data tools that solve real-world problems.</p>
        </div>
      </div>
    </div>
  </div>
</section>

  <!-- Research Section -->
  <section id="research" class="section-padding bg-gray-50 dark:bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Research & Publications</h2>
      <p class="section-subtitle text-center mx-auto">
        Academic contributions and research work in data science, pharmacy, and healthcare.
      </p>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card p-6">
          <h3 class="text-xl font-semibold mb-3">Recent Publications</h3>
          <div class="space-y-4">
            <div class="border-l-4 border-brand-primary pl-4">
              <h4 class="font-medium">Data-Driven Insights in Modern Analytics</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Journal of Data Science, 2024</p>
            </div>
            <div class="border-l-4 border-brand-secondary pl-4">
              <h4 class="font-medium">Machine Learning Applications in Real-World Scenarios</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Conference Proceedings, 2024</p>
            </div>
          </div>
          <a href="/publications" class="inline-block mt-4 text-brand-primary dark:text-brand-accent hover:underline">View all publications →</a>
        </div>
        
        <div class="card p-6">
          <h3 class="text-xl font-semibold mb-3">Current Academic Work</h3>
          <div class="space-y-4">
            <div>
              <h4 class="font-medium">Master's Thesis Research</h4>
              <p class="text-gray-600 dark:text-gray-300 text-sm">Exploring advanced machine learning techniques for predictive analytics in complex datasets.</p>
            </div>
            <div>
              <h4 class="font-medium">Coursework & Projects</h4>
              <p class="text-gray-600 dark:text-gray-300 text-sm">Advanced Statistics, Deep Learning, Research Methods, and Applied Data Science.</p>
            </div>
          </div>
          <a href="/academic" class="inline-block mt-4 text-brand-primary dark:text-brand-accent hover:underline">View academic work →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio" class="section-padding">
    <div class="container">
      <h2 class="section-title text-center">Portfolio</h2>
      <p class="section-subtitle text-center mx-auto">
        A showcase of my data visualization projects, web applications, and interactive tools.
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="card overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-brand-primary to-brand-neutral flex items-center justify-center">
            <span class="text-white text-4xl">📊</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Data Visualization Dashboard</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">Interactive dashboard showcasing sales analytics with real-time data updates and filtering capabilities.</p>
            <div class="flex gap-2 mb-4">
              <span class="px-2 py-1 bg-brand-primary/10 dark:bg-brand-primary/20 text-brand-primary dark:text-brand-neutral rounded text-xs">D3.js</span>
              <span class="px-2 py-1 bg-brand-secondary/10 dark:bg-brand-secondary/20 text-brand-secondary dark:text-brand-secondary rounded text-xs">React</span>
            </div>
            <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">View Project →</a>
          </div>
        </div>
        
        <div class="card overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-brand-secondary to-brand-accent flex items-center justify-center">
            <span class="text-white text-4xl">🤖</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">ML Prediction Tool</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">Web application for predicting outcomes using machine learning models with user-friendly interface.</p>
            <div class="flex gap-2 mb-4">
              <span class="px-2 py-1 bg-brand-accent/10 dark:bg-brand-accent/20 text-brand-accent dark:text-lime-400 rounded text-xs">Python</span>
              <span class="px-2 py-1 bg-brand-neutral/20 dark:bg-brand-neutral/30 text-brand-primary dark:text-brand-neutral rounded text-xs">Flask</span>
            </div>
            <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">View Project →</a>
          </div>
        </div>
        
        <div class="card overflow-hidden">
          <div class="h-48 bg-gradient-to-br from-brand-neutral to-brand-primary flex items-center justify-center">
            <span class="text-white text-4xl">📈</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-semibold mb-2">Analytics Platform</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">Comprehensive analytics platform for business intelligence with custom reporting features.</p>
            <div class="flex gap-2 mb-4">
              <span class="px-2 py-1 bg-brand-secondary/10 dark:bg-brand-secondary/20 text-brand-secondary dark:text-brand-secondary rounded text-xs">Vue.js</span>
              <span class="px-2 py-1 bg-brand-primary/10 dark:bg-brand-primary/20 text-brand-primary dark:text-brand-neutral rounded text-xs">Node.js</span>
            </div>
            <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">View Project →</a>
          </div>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a href="/portfolio" class="btn-primary">View All Projects</a>
      </div>
    </div>
  </section>

  <!-- Blog Section -->
  <section id="blog" class="section-padding bg-gray-50 dark:bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Latest Blog Posts</h2>
      <p class="section-subtitle text-center mx-auto">
        Thoughts, tutorials, and insights on data science, technology, and research.
      </p>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <article class="card p-6">
          <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">March 15, 2024</div>
          <h3 class="text-xl font-semibold mb-3">Getting Started with Advanced Data Visualization</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">A comprehensive guide to creating compelling visualizations that tell meaningful stories with your data.</p>
          <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">Read more →</a>
        </article>
        
        <article class="card p-6">
          <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">March 10, 2024</div>
          <h3 class="text-xl font-semibold mb-3">Machine Learning in Production</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">Best practices for deploying and maintaining machine learning models in real-world applications.</p>
          <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">Read more →</a>
        </article>
        
        <article class="card p-6">
          <div class="text-sm text-gray-500 dark:text-gray-400 mb-2">March 5, 2024</div>
          <h3 class="text-xl font-semibold mb-3">The Future of Data Science</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-4">Exploring emerging trends and technologies that are shaping the future of data science and analytics.</p>
          <a href="#" class="text-brand-primary dark:text-brand-accent hover:underline">Read more →</a>
        </article>
      </div>
      
      <div class="text-center mt-12">
        <a href="/blog" class="btn-primary">View All Posts</a>
      </div>
    </div>
  </section>

  <!-- Media Section -->
  <section id="media" class="section-padding">
    <div class="container">
      <h2 class="section-title text-center">Media & Speaking</h2>
      <p class="section-subtitle text-center mx-auto">
        Podcast appearances, conference talks, and panel discussions on data science and technology.
      </p>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-brand-primary dark:text-brand-accent">🎧</span>
            </div>
            <div>
              <a href="https://bit.ly/data-ideas-pod-s2-e47" target="_blank" rel="noopener noreferrer">
                <h4 class="font-medium">Data Ideas Podcast</h4>
              </a>
              <p class="text-sm text-gray-600 dark:text-gray-400">February 22, 2024 - "How Data Capabilities & Skills Help Scale a Startup"</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">Season 2, Episode 47</p>
            </div>
          </div>
        </div>
        
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-secondary/10 dark:bg-brand-secondary/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-brand-secondary dark:text-brand-secondary">🎧</span>
            </div>
            <div>
              <h4 class="font-medium">Tech Talk Tuesday</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Building effective data visualization tools</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="grid md:grid-cols-2 gap-8 mt-8">
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-accent/10 dark:bg-brand-accent/20 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-brand-accent dark:text-lime-400">🎯</span>
            </div>
            <div>
              <h4 class="font-medium">Data Science Conference 2024</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Keynote: "The Future of Interactive Data Visualization"</p>
            </div>
          </div>
        </div>
        
        <div class="card p-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-brand-neutral/20 dark:bg-brand-neutral/30 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-brand-primary dark:text-brand-neutral">🎯</span>
            </div>
            <div>
              <h4 class="font-medium">ML Summit 2024</h4>
              <p class="text-sm text-gray-600 dark:text-gray-400">Panel: "Ethics in Machine Learning Applications"</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="text-center mt-12">
        <a href="/media" class="btn-primary">View All Media</a>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="section-padding bg-gray-50 dark:bg-gray-800">
    <div class="container">
      <h2 class="section-title text-center">Get In Touch</h2>
      <p class="section-subtitle text-center mx-auto">
        Interested in collaboration, speaking opportunities, or just want to chat about data science? I'd love to hear from you.
      </p>
      
      <div class="max-w-4xl mx-auto">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-xl font-semibold mb-6">Let's Connect</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-brand-primary/10 dark:bg-brand-primary/20 rounded-lg flex items-center justify-center">
                  <span class="text-brand-primary dark:text-brand-accent">📧</span>
                </div>
                <div>
                  <h4 class="font-medium">Email</h4>
                  <p class="text-gray-600 dark:text-gray-300">nicoledesignsdata@pm.me</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-brand-secondary/10 dark:bg-brand-secondary/20 rounded-lg flex items-center justify-center">
                  <span class="text-brand-secondary dark:text-brand-secondary">💼</span>
                </div>
                <div>
                  <h4 class="font-medium">LinkedIn</h4>
                  <p class="text-gray-600 dark:text-gray-300">linkedin.com/in/nicole-mark</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                  <span class="text-gray-600 dark:text-gray-400">🐙</span>
                </div>
                <div>
                  <h4 class="font-medium">GitHub</h4>
                  <p class="text-gray-600 dark:text-gray-300">github.com/nicolelily</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="card p-6">
            <h3 class="text-xl font-semibold mb-6">Send a Message</h3>
            <form 
              action="https://formspree.io/f/mpwjkdqk"
              method="POST" 
              class="space-y-4" 
              id="homepage-contact-form"
            >
              <!-- Honeypot for spam protection -->
              <input type="text" name="_gotcha" style="display:none" />
              
              <div>
                <label for="home-name" class="block text-sm font-medium mb-2">Name</label>
                <input type="text" id="home-name" name="name" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent">
              </div>
              <div>
                <label for="home-email" class="block text-sm font-medium mb-2">Email</label>
                <input type="email" id="home-email" name="_replyto" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent">
              </div>
              <div>
                <label for="home-message" class="block text-sm font-medium mb-2">Message</label>
                <textarea id="home-message" name="message" rows="4" required class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-brand-primary focus:border-transparent"></textarea>
              </div>
              
              <!-- Success/Error Messages -->
              <div id="home-form-messages" class="hidden">
                <div id="home-success-message" class="hidden p-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-lg text-sm">
                  <span class="text-green-600 dark:text-green-400">✓ Message sent! I'll get back to you soon.</span>
                </div>
                <div id="home-error-message" class="hidden p-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-lg text-sm">
                  <span class="text-red-600 dark:text-red-400">Something went wrong. Please try the full contact form or email me directly.</span>
                </div>
              </div>
              
              <button type="submit" id="home-submit-button" class="btn-primary w-full">
                <span id="home-button-text">Send Message</span>
                <span id="home-button-loading" class="hidden">Sending...</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-900 text-white py-12">
    <div class="container">
      <div class="text-center">
        <h3 class="text-2xl font-bold mb-4">Nicole L. Mark</h3>
        <p class="text-gray-400 mb-6">Data Scientist • Researcher • Developer</p>
        <div class="flex justify-center space-x-6">
          <a href="https://linkedin.com/in/nicole-mark" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">LinkedIn</a>
          <a href="https://github.com/nicolelily" target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-white transition-colors">GitHub</a>
          <a href="mailto:nicoledesignsdata@pm.me" class="text-gray-400 hover:text-white transition-colors">Email</a>
          <a href="/blog" class="text-gray-400 hover:text-white transition-colors">Blog</a>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-800 text-gray-500 text-sm">
          <p>&copy; 2025 Nicole L. Mark. All rights reserved.</p>
        </div>
      </div>
    </div>
  </footer>
  
  <script>
    // Homepage contact form handling
    document.addEventListener('DOMContentLoaded', function() {
      const homeForm = document.getElementById('homepage-contact-form');
      
      if (homeForm) {
        const submitButton = document.getElementById('home-submit-button');
        const buttonText = document.getElementById('home-button-text');
        const buttonLoading = document.getElementById('home-button-loading');
        const formMessages = document.getElementById('home-form-messages');
        const successMessage = document.getElementById('home-success-message');
        const errorMessage = document.getElementById('home-error-message');
        
        homeForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          
          // Show loading state
          submitButton.disabled = true;
          buttonText.classList.add('hidden');
          buttonLoading.classList.remove('hidden');
          
          // Hide any previous messages
          formMessages.classList.add('hidden');
          successMessage.classList.add('hidden');
          errorMessage.classList.add('hidden');
          
          try {
            const formData = new FormData(this);
            const formAction = this.getAttribute('action');
            
            if (formAction.includes('REPLACE_WITH_YOUR_FORM_ID')) {
              throw new Error('PLACEHOLDER_MODE');
            }
            
            const response = await fetch(formAction, {
              method: 'POST',
              body: formData,
              headers: {
                'Accept': 'application/json'
              }
            });
            
            if (response.ok) {
              formMessages.classList.remove('hidden');
              successMessage.classList.remove('hidden');
              this.reset();
            } else {
              throw new Error('Form submission failed');
            }
            
          } catch (error) {
            if (error.message === 'PLACEHOLDER_MODE') {
              alert('Form setup needed! Please use the full contact page or email me directly at nicoledesignsdata@pm.me');
            } else {
              formMessages.classList.remove('hidden');
              errorMessage.classList.remove('hidden');
            }
          } finally {
            submitButton.disabled = false;
            buttonText.classList.remove('hidden');
            buttonLoading.classList.add('hidden');
          }
        });
      }
    });
  </script>
</Layout>
