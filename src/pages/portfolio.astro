---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
---

<Layout title="Portfolio - Nicole L. Mark">
  <Navigation />
  
  <main class="pt-24">
    <!-- Portfolio Header -->
    <section class="section-padding bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-900 dark:to-gray-800">
      <div class="container">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4">
            Portfolio
          </h1>
          <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
            A showcase of my data visualization projects, web applications, and interactive tools that demonstrate the intersection of data science and user experience design.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <button class="btn-primary filter-btn active" data-filter="all">All Projects</button>
            <button class="btn-secondary filter-btn" data-filter="visualization">Data Visualization</button>
            <button class="btn-secondary filter-btn" data-filter="webapp">Web Applications</button>
            <button class="btn-secondary filter-btn" data-filter="ml">Machine Learning</button>
            <button class="btn-secondary filter-btn" data-filter="research">Research Tools</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title text-center">Featured Projects</h2>
        
        <div class="grid lg:grid-cols-2 gap-12 mb-16">
          <div class="card overflow-hidden project-item" data-category="visualization webapp">
            <div class="h-64 bg-gradient-to-br from-blue-400 to-purple-500 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-black bg-opacity-20"></div>
              <div class="relative z-10 text-center text-white">
                <div class="text-6xl mb-4">📊</div>
                <h3 class="text-xl font-semibold">Interactive Dashboard</h3>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-3">
                Healthcare Analytics Dashboard
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">
                A comprehensive real-time dashboard for healthcare analytics featuring patient outcome predictions, resource utilization tracking, and interactive data exploration tools. Built with React, D3.js, and Python backend.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">React</span>
                <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">D3.js</span>
                <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">Python</span>
                <span class="px-3 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full text-sm">Healthcare</span>
              </div>
              <div class="flex gap-3">
                <a href="#" class="btn-primary flex-1 text-center">Live Demo</a>
                <a href="#" class="btn-secondary flex-1 text-center">View Code</a>
              </div>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="ml webapp">
            <div class="h-64 bg-gradient-to-br from-green-400 to-blue-500 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 bg-black bg-opacity-20"></div>
              <div class="relative z-10 text-center text-white">
                <div class="text-6xl mb-4">🤖</div>
                <h3 class="text-xl font-semibold">ML Prediction Platform</h3>
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-2xl font-semibold text-gray-900 dark:text-white mb-3">
                Financial Risk Assessment Tool
              </h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">
                An interpretable machine learning platform for financial risk assessment that provides both predictions and explanations. Features ensemble models, SHAP explanations, and regulatory compliance reporting.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded-full text-sm">Scikit-learn</span>
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Flask</span>
                <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">SHAP</span>
                <span class="px-3 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded-full text-sm">Finance</span>
              </div>
              <div class="flex gap-3">
                <a href="#" class="btn-primary flex-1 text-center">Live Demo</a>
                <a href="#" class="btn-secondary flex-1 text-center">Case Study</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- All Projects Grid -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <h2 class="section-title text-center">All Projects</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8" id="projects-grid">
          <!-- Data Visualization Projects -->
          <div class="card overflow-hidden project-item" data-category="visualization webapp">
            <div class="h-48 bg-gradient-to-br from-purple-400 to-pink-500 flex items-center justify-center">
              <span class="text-white text-4xl">🐕</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Dog Breeds Explorer</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Interactive Streamlit application featuring scatter plots, bar charts, and sunburst visualizations for exploring dog breed characteristics and statistics.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">Python</span>
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Streamlit</span>
                <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Plotly</span>
              </div>
              <div class="flex gap-2">
                <a href="https://nicolelily-dog-breeds-streamlit-app-tjc0dw.streamlit.app" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">Live App →</a>
                <a href="https://github.com/nicolelily/dog-breeds-streamlit" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">View Code →</a>
              </div>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="visualization">
            <div class="h-48 bg-gradient-to-br from-red-400 to-orange-500 flex items-center justify-center">
              <span class="text-white text-4xl">🔥</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Canada Wildfires 2023 Analysis</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Interactive beeswarm plot visualization analyzing wildfire patterns across Canadian provinces using TypeScript and D3.js. Created as part of Nael Shiab's "Code Like a Journalist" course.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">TypeScript</span>
                <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">D3.js</span>
                <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded text-xs">Data Journalism</span>
                <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">Deno</span>
              </div>
              <div class="flex gap-2">
                <a href="https://github.com/nicolelily/canada-wildfires" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">View Code →</a>
                <a href="https://www.code-like-a-journalist.com/en" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">Course →</a>
              </div>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="visualization webapp">
            <div class="h-48 bg-gradient-to-br from-red-400 to-yellow-500 flex items-center justify-center">
              <span class="text-white text-4xl">🗺️</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Rude Cities Interactive Map</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Interactive map visualization of cities in the U.S. ranked by rudeness as measured by Preply's study, featuring geographic data visualization and user interaction patterns.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">Interactive Maps</span>
                <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">Data Viz</span>
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Geographic Data</span>
              </div>
              <div class="flex gap-2">
                <a href="https://github.com/nicolelily/rude-cities" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">View Code →</a>
              </div>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="visualization">
            <div class="h-48 bg-gradient-to-br from-teal-400 to-blue-500 flex items-center justify-center">
              <span class="text-white text-4xl">💹</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Stock Market Sentiment Analysis</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Real-time visualization of stock market sentiment derived from social media and news sources.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 rounded text-xs">React</span>
                <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">NLP</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <!-- Web Applications -->
          <div class="card overflow-hidden project-item" data-category="webapp">
            <div class="h-48 bg-gradient-to-br from-orange-400 to-red-500 flex items-center justify-center">
              <span class="text-white text-4xl">🏥</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Patient Management System</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Full-stack web application for healthcare providers to manage patient records and appointments with data analytics.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">React</span>
                <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Node.js</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="webapp">
            <div class="h-48 bg-gradient-to-br from-pink-400 to-purple-500 flex items-center justify-center">
              <span class="text-white text-4xl">📚</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Research Paper Analyzer</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Web tool for analyzing and visualizing trends in academic research papers using NLP and network analysis.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">Flask</span>
                <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">spaCy</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <!-- Machine Learning Projects -->
          <div class="card overflow-hidden project-item" data-category="ml">
            <div class="h-48 bg-gradient-to-br from-cyan-400 to-blue-500 flex items-center justify-center">
              <span class="text-white text-4xl">🧠</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Deep Learning Image Classifier</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">CNN-based image classification system for medical imaging with attention mechanisms and interpretability features.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">PyTorch</span>
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Computer Vision</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="ml">
            <div class="h-48 bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center">
              <span class="text-white text-4xl">🔮</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Time Series Forecasting Model</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">LSTM-based forecasting system for energy consumption prediction with uncertainty quantification.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">TensorFlow</span>
                <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">Time Series</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <!-- Research Tools -->
          <div class="card overflow-hidden project-item" data-category="research">
            <div class="h-48 bg-gradient-to-br from-violet-400 to-purple-500 flex items-center justify-center">
              <span class="text-white text-4xl">🔬</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Statistical Analysis Toolkit</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Python package for advanced statistical analysis with automated report generation and visualization.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">Python</span>
                <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded text-xs">Statistics</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>

          <div class="card overflow-hidden project-item" data-category="research">
            <div class="h-48 bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center">
              <span class="text-white text-4xl">📊</span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-semibold mb-2">Experiment Design Platform</h3>
              <p class="text-gray-600 dark:text-gray-300 mb-4">Web-based platform for designing and analyzing A/B tests and controlled experiments with power analysis.</p>
              <div class="flex gap-2 mb-4">
                <span class="px-2 py-1 bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 rounded text-xs">R Shiny</span>
                <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Statistics</span>
              </div>
              <a href="#" class="text-blue-600 dark:text-blue-400 hover:underline">View Project →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills & Technologies -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title text-center">Technologies & Tools</h2>
        
        <div class="grid md:grid-cols-4 gap-8">
          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🐍</div>
            <h3 class="text-lg font-semibold mb-2">Data Science</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Python</span>
              <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">R</span>
              <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">Pandas</span>
              <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">NumPy</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🤖</div>
            <h3 class="text-lg font-semibold mb-2">Machine Learning</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">TensorFlow</span>
              <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded text-xs">PyTorch</span>
              <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Scikit-learn</span>
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Keras</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">📊</div>
            <h3 class="text-lg font-semibold mb-2">Visualization</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">D3.js</span>
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Plotly</span>
              <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Matplotlib</span>
              <span class="px-2 py-1 bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 rounded text-xs">Seaborn</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🌐</div>
            <h3 class="text-lg font-semibold mb-2">Web Development</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">React</span>
              <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Node.js</span>
              <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">Flask</span>
              <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">FastAPI</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="section-padding bg-gray-50 dark:bg-gray-800">
      <div class="container">
        <div class="text-center">
          <h2 class="section-title">Interested in Collaboration?</h2>
          <p class="section-subtitle mx-auto">
            I'm always excited to work on new projects and explore innovative applications of data science and visualization.
          </p>
          <div class="flex justify-center gap-4">
            <a href="/contact" class="btn-primary">Get In Touch</a>
            <a href="https://github.com/nicolelily" class="btn-secondary" target="_blank">View GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    // Simple project filtering functionality
    document.addEventListener('DOMContentLoaded', function() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const projectItems = document.querySelectorAll('.project-item');

      filterButtons.forEach(button => {
        button.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          
          // Update active button
          filterButtons.forEach(btn => {
            btn.classList.remove('btn-primary', 'active');
            btn.classList.add('btn-secondary');
          });
          this.classList.remove('btn-secondary');
          this.classList.add('btn-primary', 'active');

          // Filter projects
          projectItems.forEach(item => {
            if (filter === 'all' || item.getAttribute('data-category').includes(filter)) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</Layout>

