---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import '../styles/global.css';
---

<Layout title="Tableau Visualizations - Nicole L. Mark">
  <Navigation />
  
  <main class="pt-24">
    <!-- Tableau Header -->
    <section class="section-padding bg-gradient-to-br from-gray-900 to-gray-800">
      <div class="container">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
            Tableau Visualizations
          </h1>
          <p class="text-xl text-gray-300 mb-8 max-w-3xl mx-auto">
            Interactive data visualizations and dashboards created with Tableau Desktop and Tableau Prep, showcasing insights from complex datasets across healthcare, public policy, environmental sustainability, social justice, and cultural analysis.
          </p>
          <div class="flex flex-wrap justify-center gap-4">
            <button class="btn-primary filter-btn active" data-filter="all">All Projects</button>
            <button class="btn-secondary filter-btn" data-filter="healthcare">Healthcare</button>
            <button class="btn-secondary filter-btn" data-filter="public-policy">Public Policy</button>
            <button class="btn-secondary filter-btn" data-filter="environment-climate-and-sustainability">Environment & Climate</button>
            <button class="btn-secondary filter-btn" data-filter="social-justice">Social Justice</button>
            <button class="btn-secondary filter-btn" data-filter="pop-culture">Pop Culture</button>
            <button class="btn-secondary filter-btn" data-filter="exploratory">Exploratory Analysis</button>
            <button class="btn-secondary filter-btn" data-filter="other">Other</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Tableau Public Profile Link -->
    <section class="section-padding">
      <div class="container">
        <div class="card p-6 text-center max-w-2xl mx-auto mb-12">
          <h2 class="text-2xl font-semibold text-white mb-3">
            View All Work on Tableau Public
          </h2>
          <p class="text-gray-300 mb-4">
            Explore my complete collection of interactive visualizations and dashboards on Tableau Public.
          </p>
          <a href="https://public.tableau.com/app/profile/nicole.mark/vizzes" 
             target="_blank" 
             rel="noopener noreferrer" 
             class="btn-primary inline-flex items-center gap-2">
            <span>Visit My Tableau Public Profile</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Interactive Visualizations -->
    <section class="section-padding bg-gray-800">
      <div class="container">
        <h2 class="section-title text-center">Interactive Visualizations</h2>
        
        <div class="space-y-12" id="tableau-projects">
          <!-- Gender Pay Gap Visualization - Featured Project -->
          <div class="tableau-project" data-category="social-justice">
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <h3 class="text-2xl font-semibold text-white">
                  The gender pay gap in data visualization
                </h3>
                <div class="flex gap-2">
                  <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs font-medium">Viz of the Day</span>
                  <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs font-medium">DVS Winner</span>
                </div>
              </div>
              <p class="text-gray-300 mb-4">
                This interactive data visualization explores my analysis of the 2023 Data Visualization Society State of the Industry Survey, revealing gender-based pay inequity in the field of data visualization, especially in the highest-paying positions. This piece was selected by Tableau as the Viz of the Day on March 28, 2024, and was recognized as a winner in the Explanatory category in DVS's 2023 State of the Industry Survey Challenge.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">Editorial</span>
                <span class="px-3 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded-full text-sm">Gender Equity</span>
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Pay Equity</span>
                <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">Survey Analysis</span>
              </div>
              <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-400 mb-4">
                <div>
                  <p><strong>Data Source:</strong> Data Visualization Society State of the Industry Survey, 2023</p>
                  <p><strong>Tools Used:</strong> Tableau Desktop</p>
                </div>
                <div>
                  <p><strong>Key Features:</strong> Multiple chart types (histogram, treemap, stacked bar chart, connected dot plot), interactive filtering</p>
                  <p><strong>Recognition:</strong> Tableau Viz of the Day (March 28, 2024), DVS Challenge Winner (Explanatory category)</p>
                </div>
              </div>
              <div class="flex gap-3">
                <a href="https://public.tableau.com/app/profile/nicole.mark/viz/ThegenderpaygapindatavisualizationDVSStateoftheIndustrySurvey2023/Thegenderpaygapindatavisualization" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-primary inline-flex items-center gap-2">
                  <span>View on Tableau Public</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
                <a href="https://www.datavisualizationsociety.org/survey-history" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-secondary text-sm">
                  Data Source
                </a>
              </div>
            </div>
          </div>

          <!-- HRC Corporate Equality Index - Featured Project -->
          <div class="tableau-project" data-category="social-justice">
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <h3 class="text-2xl font-semibold text-white">
                  Human Rights Campaign Corporate Equality Index 2022
                </h3>
                <div class="flex gap-2">
                  <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs font-medium">Viz of the Day</span>
                </div>
              </div>
              <p class="text-gray-300 mb-4">
                This project is an interactive exploration of the Human Rights Campaign's Corporate Equality Index for 2022. The Human Rights Campaign Corporate Equality Index (CEI) is America's premier benchmarking tool that evaluates how inclusive corporate policies, practices, and benefits are for LGBTQ+ employees and their families. Published annually since 2002 by the Human Rights Campaign Foundation, the CEI uses a 100-point scoring system to rate businesses on their treatment of gay, lesbian, bisexual, transgender, and queer employees, consumers, and investors. This piece was selected by Tableau as the Viz of the Day on August 5, 2022.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">Editorial</span>
                <span class="px-3 py-1 bg-pink-100 dark:bg-pink-900 text-pink-800 dark:text-pink-200 rounded-full text-sm">LGBTQ+</span>
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Benchmarking</span>
                <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">Inclusivity</span>
              </div>
              <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-400 mb-4">
                <div>
                  <p><strong>Data Source:</strong> Human Rights Campaign Corporate Equality Index, 2022</p>
                  <p><strong>Tools Used:</strong> Tableau Desktop</p>
                </div>
                <div>
                  <p><strong>Key Features:</strong> Geospatial data analysis, UX design, interactive filtering</p>
                  <p><strong>Recognition:</strong> Tableau Viz of the Day (August 5, 2022)</p>
                </div>
              </div>
              <div class="flex gap-3">
                <a href="https://public.tableau.com/views/HumanRightsCampaignCorporateEqualityIndex2022/Home" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-primary inline-flex items-center gap-2">
                  <span>View on Tableau Public</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
                <a href="https://reports.hrc.org/corporate-equality-index-2022" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-secondary text-sm">
                  Data Source
                </a>
              </div>
            </div>
          </div>

          <!-- Stats+Stories 300th Episode Contest Winner -->
          <div class="tableau-project" data-category="pop-culture exploratory">
            <div class="card p-6">
              <div class="flex items-center gap-3 mb-3">
                <h3 class="text-2xl font-semibold text-white">
                  Stats+Stories 300th Episode Data Visualization Contest
                </h3>
                <div class="flex gap-2">
                  <span class="px-2 py-1 bg-gold-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs font-medium">Contest Winner</span>
                  <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs font-medium">IronQuest Featured</span>
                </div>
              </div>
              <p class="text-gray-300 mb-4">
                This project is a celebration of the Stats+Stories podcast! To commemorate their 300th episode, they shared their episodes dataset and hosted a data visualization competition. I entered the contest and won first place for this piece, built around an interactive radial bubble chart. This visualization was also featured in the May 2023 IronQuest community initiative with the theme of advanced chart types. I had the opportunity to discuss my visualization with the Stats+Stories team on their podcast.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded-full text-sm">Podcast</span>
                <span class="px-3 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded-full text-sm">Data Storytelling</span>
                <span class="px-3 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded-full text-sm">IronQuest</span>
                <span class="px-3 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded-full text-sm">Statistics</span>
              </div>
              <div class="grid md:grid-cols-2 gap-4 text-sm text-gray-400 mb-4">
                <div>
                  <p><strong>Data Source:</strong> Stats+Stories Episodes Dataset</p>
                  <p><strong>Tools Used:</strong> Tableau Desktop</p>
                </div>
                <div>
                  <p><strong>Key Features:</strong> Viz in tooltip, UX design, interactive radial bubble chart, advanced chart types</p>
                  <p><strong>Recognition:</strong> First Place Winner, IronQuest Featured (May 2023)</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-3">
                <a href="https://public.tableau.com/views/StatsStories300thEpisodeDataVisualizationContest/StatsStories300thEpisode" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-primary inline-flex items-center gap-2">
                  <span>View on Tableau Public</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                  </svg>
                </a>
                <a href="https://statsandstories.squarespace.com/dataviz300" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-secondary text-sm">
                  Contest Details
                </a>
                <a href="https://statsandstories.net/methods/data-visualization-contest-winner" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-secondary text-sm">
                  Podcast Feature
                </a>
                <a href="https://www.youtube.com/watch?v=Lie595Q9wU8" 
                   target="_blank" 
                   rel="noopener noreferrer" 
                   class="btn-secondary text-sm inline-flex items-center gap-1">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                  <span>IronQuest Video</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills & Techniques -->
    <section class="section-padding">
      <div class="container">
        <h2 class="section-title text-center">Tableau Skills & Techniques</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🎨</div>
            <h3 class="text-lg font-semibold mb-2">Design & UX</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 rounded text-xs">Dashboard Design</span>
              <span class="px-2 py-1 bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 rounded text-xs">Color Theory</span>
              <span class="px-2 py-1 bg-purple-100 dark:bg-purple-900 text-purple-800 dark:text-purple-200 rounded text-xs">User Experience</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🔄</div>
            <h3 class="text-lg font-semibold mb-2">Data Preparation</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 rounded text-xs">Tableau Prep Builder</span>
              <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 rounded text-xs">Data Cleaning</span>
              <span class="px-2 py-1 bg-teal-100 dark:bg-teal-900 text-teal-800 dark:text-teal-200 rounded text-xs">ETL Processes</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">📊</div>
            <h3 class="text-lg font-semibold mb-2">Advanced Analytics</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-orange-100 dark:bg-orange-900 text-orange-800 dark:text-orange-200 rounded text-xs">Calculated Fields</span>
              <span class="px-2 py-1 bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 rounded text-xs">Parameters</span>
              <span class="px-2 py-1 bg-pink-100 dark:bg-pink-900 text-pink-800 dark:text-pink-200 rounded text-xs">Statistical Functions</span>
            </div>
          </div>

          <div class="card p-6 text-center">
            <div class="text-4xl mb-4">🌐</div>
            <h3 class="text-lg font-semibold mb-2">Publishing & Sharing</h3>
            <div class="flex flex-wrap justify-center gap-1">
              <span class="px-2 py-1 bg-cyan-100 dark:bg-cyan-900 text-cyan-800 dark:text-cyan-200 rounded text-xs">Tableau Public</span>
              <span class="px-2 py-1 bg-lime-100 dark:bg-lime-900 text-lime-800 dark:text-lime-200 rounded text-xs">Tableau Server</span>
              <span class="px-2 py-1 bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-200 rounded text-xs">Embedding</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="section-padding bg-gray-800">
      <div class="container">
        <div class="text-center">
          <h2 class="section-title">Interested in Data Visualization Collaboration?</h2>
          <p class="section-subtitle mx-auto">
            I'm passionate about creating compelling visual stories from complex data. Let's discuss how we can bring your data to life through interactive visualization.
          </p>
          <div class="flex justify-center gap-4">
            <a href="/contact" class="btn-primary">Get In Touch</a>
            <a href="/portfolio" class="btn-secondary">View All Projects</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <style>
    .tableau-container {
      @apply bg-gray-800 rounded-xl p-4 min-h-[400px] lg:min-h-[500px];
    }
    
    .tableau-placeholder {
      @apply bg-gray-700 rounded-lg border-2 border-dashed border-gray-600 min-h-[350px] lg:min-h-[450px];
    }
    
    .tableau-project {
      @apply transition-opacity duration-300;
    }
    
    .tableau-project.hidden {
      @apply opacity-0 pointer-events-none h-0 overflow-hidden;
    }
  </style>

  <script>
    // Tableau project filtering functionality
    document.addEventListener('DOMContentLoaded', function() {
      const filterButtons = document.querySelectorAll('.filter-btn');
      const projects = document.querySelectorAll('.tableau-project');

      filterButtons.forEach(button => {
        button.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          
          // Update active button
          filterButtons.forEach(btn => {
            btn.classList.remove('btn-primary', 'active');
            btn.classList.add('btn-secondary');
          });
          this.classList.remove('btn-secondary');
          this.classList.add('btn-primary', 'active');

          // Filter projects
          projects.forEach(project => {
            const category = project.getAttribute('data-category');
            if (filter === 'all' || category.includes(filter)) {
              project.classList.remove('hidden');
            } else {
              project.classList.add('hidden');
            }
          });
        });
      });

      // No Tableau JavaScript API needed since we're using direct links
    });
  </script>
</Layout>